{
  "description": "Sequential on Rakuten, text and image input, with the fixes for a fair comparison",
  "based_on": "experiments/rakuten/txt+img/sequential.json",
  "model_type": "sequential",
  "modality": "txt+img",
  "vocab": {
    "distinct_unk": true
  },
  "preprocess": {
    "train_img": "train.img",
    "train_src": "train.tit",
    "train_tgt": "train.lbl",
    "valid_img": "valid.img",
    "valid_src": "valid.tit",
    "valid_tgt": "valid.lbl",
    "src_vocab": "train.tit.json",
    "tgt_vocab": "train.lbl.json",
    "max_len": 1000
  },
  "train": {
    "batch_size": 32,
    "d_model": 1024,
    "n_warmup_steps": 4000,
    "save_mode": "best",
    "patience": 3,
    "select_by": "chain_accuracy",
    "decode_steps": 8,
    "label_smoothing": 0.1,
    "train_crop": "random_resized_crop",
    "valid_crop": "center_crop",
    "frozen_resnet": true
  },
  "translate": {
    "valid": {
      "img": "valid.img",
      "src": "valid.tit"
    },
    "test": {
      "img": "test.img",
      "src": "test.tit"
    },
    "batch_size": 64,
    "test_crop": "center_crop",
    "decode_steps": 8,
    "deterministic": true
  },
  "evaluate": {
    "valid": "valid.lbl",
    "test": "test.lbl",
    "n_attributes": 7
  }
}
