{
  "description": "Binary MultiLabel on the H&M data split with -seed, text input",
  "model_type": "multilabel",
  "modality": "txt",
  "missing_values": [
    "Unknown",
    "Undefined",
    "undefined"
  ],
  "hm": {
    "valid_size": 5000,
    "test_size": 5000,
    "sp_vocab_size": 4000,
    "distinct_unk": true
  },
  "train": {
    "batch_size": 32,
    "d_model": 1024,
    "n_warmup_steps": 4000,
    "save_mode": "best",
    "patience": 3,
    "select_by": "chain_accuracy",
    "label_smoothing": 0.1,
    "mask_padding": true
  },
  "translate": {
    "batch_size": 32,
    "deterministic": true
  },
  "evaluate": {
    "n_attributes": 11
  }
}
