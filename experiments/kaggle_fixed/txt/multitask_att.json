{
  "description": "Attentive MultiTask on Kaggle, text input, with the fixes for a fair comparison",
  "based_on": "experiments/kaggle/txt/multitask_att.json",
  "model_type": "multitask_att",
  "modality": "txt",
  "missing_values": [
    "NA",
    "None"
  ],
  "exclude_ids": [
    "28319"
  ],
  "vocab": {
    "distinct_unk": true
  },
  "preprocess": {
    "train_src": "train.enc.tit",
    "train_tgt": "train.lbl",
    "valid_src": "valid.enc.tit",
    "valid_tgt": "valid.lbl",
    "src_vocab": "train.enc.tit.json",
    "tgt_vocab": "train.lbl.json",
    "max_len": 1000
  },
  "train": {
    "batch_size": 32,
    "d_model": 1024,
    "n_warmup_steps": 4000,
    "save_mode": "best",
    "patience": 3,
    "select_by": "chain_accuracy",
    "label_smoothing": 0.1,
    "mask_padding": true
  },
  "translate": {
    "valid": {
      "src": "valid.enc.tit"
    },
    "test": {
      "src": "test.enc.tit"
    },
    "batch_size": 64,
    "deterministic": true
  },
  "evaluate": {
    "valid": "valid.lbl",
    "test": "test.lbl",
    "n_attributes": 8
  }
}
