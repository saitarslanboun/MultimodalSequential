{
  "experiment": "RakutenDatasetExperiments/TXT+IMG/MultiLabelMultiClass_SlfAtt",
  "description": "Self-Attentive MultiTask on Rakuten, text and image input",
  "model_type": "multitask_slfatt",
  "modality": "txt+img",
  "preprocess": {
    "train_img": "train.img",
    "train_src": "train.tit",
    "train_tgt": "train.lbl",
    "valid_img": "valid.img",
    "valid_src": "valid.tit",
    "valid_tgt": "valid.lbl",
    "src_vocab": "train.tit.json",
    "tgt_vocab": "train.lbl.json",
    "max_len": 1000
  },
  "train": {
    "batch_size": 32,
    "d_model": 1024,
    "n_warmup_steps": 4000,
    "save_mode": "all",
    "train_crop": "random_resized_crop",
    "no_proj1_bias": true,
    "unused_slf_attention": true
  },
  "translate": {
    "valid": {
      "img": "valid.img",
      "src": "valid.tit"
    },
    "test": {
      "img": "test.img",
      "src": "test.tit"
    },
    "batch_size": 64,
    "test_crop": "random_resized_crop"
  },
  "evaluate": {
    "valid": "valid.lbl",
    "test": "test.lbl",
    "n_attributes": 7
  },
  "paper_checkpoint": "models/model.3.chkpt"
}
