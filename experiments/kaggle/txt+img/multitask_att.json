{
  "experiment": "KaggleDatasetExperiments/TXT+IMG/MultiLabelMultiClass_Att",
  "description": "Attentive MultiTask on Kaggle, text and image input",
  "model_type": "multitask_att",
  "modality": "txt+img",
  "preprocess": {
    "train_img": "train.img",
    "train_src": "train.enc.tit",
    "train_tgt": "train.lbl",
    "valid_img": "valid.img",
    "valid_src": "valid.enc.tit",
    "valid_tgt": "valid.lbl",
    "src_vocab": "train.tit.json",
    "tgt_vocab": "train.lbl.json",
    "max_len": 1000
  },
  "train": {
    "batch_size": 32,
    "d_model": 1024,
    "n_warmup_steps": 4000,
    "save_mode": "all",
    "train_crop": "random_resized_crop"
  },
  "translate": {
    "valid": {
      "img": "valid.img",
      "src": "valid.enc.tit"
    },
    "test": {
      "img": "test.img",
      "src": "test.enc.tit"
    },
    "batch_size": 64,
    "test_crop": "random_resized_crop"
  },
  "evaluate": {
    "valid": "valid.lbl",
    "test": "test.lbl",
    "n_attributes": 8
  },
  "paper_checkpoint": "models/model.9.chkpt"
}
