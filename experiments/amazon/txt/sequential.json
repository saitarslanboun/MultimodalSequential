{
  "experiment": "AmazonDatasetExperiments/TXT/EncoderDecoder",
  "description": "Sequential on Amazon, text input",
  "model_type": "sequential",
  "modality": "txt",
  "preprocess": {
    "train_src": "etrain.tit",
    "train_tgt": "etrain.lbl",
    "valid_src": "evalid.tit",
    "valid_tgt": "evalid.lbl",
    "src_vocab": "etrain.tit.json",
    "tgt_vocab": "etrain.lbl.json",
    "max_len": 1000
  },
  "train": {
    "batch_size": 32,
    "d_model": 1024,
    "n_warmup_steps": 4000,
    "save_mode": "all"
  },
  "translate": {
    "valid": {
      "src": "valid.enc.tit"
    },
    "test": {
      "src": "test.enc.tit"
    },
    "batch_size": 64,
    "decode_steps": 10,
    "no_check_chain": true
  },
  "evaluate": {
    "valid": "valid.cat",
    "test": "test.cat",
    "chains": true
  },
  "paper_checkpoint": "models/model.7.chkpt"
}
